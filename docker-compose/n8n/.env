# n8n
N8N_VERSION=latest
N8N_CONTAINER_NAME=aml-n8n
N8N_PORT=5678

# Timezone
TIMEZONE=Africa/Johannesburg

# n8n encryption
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# PostgreSQL
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=dbuser
DB_POSTGRESDB_PASSWORD=ChangeThisToAStrongPassword

